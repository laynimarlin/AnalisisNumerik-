import numpy as np
import matplotlib.pyplot as plt

#Data titik
x = np.array([1.0, 2.0, 3.0])
y = np.array([3.0, 8.0, 15.0])
xp = 2.5
#Fungsi interpolasi lagrange
def lagrange(x, y,xp):
  p = 0.0
  n = len(x)
  for i in range(n):
    L = 1.0
    for j in range(n):
      if j != i:
        L *= (xp - x[j]) / (x[i] - x[j])
    p += y[i] * L
  return p

#Hitung nilai f(2.5)
L_value = lagrange(x, y, xp)
print("lagrange f(2.5) =", L_value)

#Bagian Grafik Interpolasi Lagrange
x_plot = np.linspace(min(x), max(x), 200)
y_plot = [lagrange(x, y, xi) for xi in x_plot]

plt.figure(figsize=(7,5))
plt.plot(x_plot, y_plot, label="Kurva Interpolasi Lagrange")
plt.scatter(x, y, color='red', zorder=5, label="Titik Data")
plt.scatter([xp], [L_value], color='green', zorder=5, label=f"f({xp}) = {L_value:.3f}")

plt.title("Interpolasi Lagrange")
plt.xlabel("x")
plt.ylabel("y")
plt.legend()
plt.grid(True)

plt.show()
