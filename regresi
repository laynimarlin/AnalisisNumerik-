import numpy as np
import matplotlib.pyplot as plt

#Data
x = np.array([10, 20, 30, 40])  #ukuran aplikasi (MB)
y = np.array([2.5, 4, 5, 6.5])  #waktu muat (detik)

#Hitung parameter regrasi
n = len(x)
x_mean = np.mean(x)
y_mean = np.mean(y)

#Rumus slope (b1) dan intercept (b0)
b1 = np.sum((x - x_mean)* (y - y_mean)) / np.sum((x - x_mean) **2)
b0 = y_mean - b1 * x_mean

print("persamaan regresi: y = {:.4f}x + {:.4f}".format(b1, b0))

#Contoh prediksi (misalnya ukuran 25 MB)
x_prediction = 25
y_prediction = b0 + b1 * x_prediction
print("prediksi waktu muat untuk ukuran 25 MB =", y_prediction)

#Bagian Grafik Regresi Linear
x_line = np.linspace(min(x), max(x), 200)
y_line = b0 + b1 * x_line

plt.figure(figsize=(7,5))
plt.scatter(x, y, color="red", label="Data Asli")
plt.plot(x_line, y_line, label="Garis Regresi Linear")
plt.scatter([x_prediction], [y_prediction], color="green",
            label=f"Prediksi: ({x_prediction}, {y_prediction:.2f})")

plt.title("Regresi Linear: Ukuran Aplikasi vs Waktu Muat")
plt.xlabel("Ukuran Aplikasi (MB)")
plt.ylabel("Waktu Muat (detik)")
plt.grid(True)
plt.legend()

plt.show()
